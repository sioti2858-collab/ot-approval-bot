# ==========================================================
#  OT Approval Bot - contoh konfigurasi
#  Salin file ini menjadi ".env" lalu isi dengan data Anda.
#  .env TIDAK boleh di-commit ke git.
# ==========================================================

# --- Telegram ---------------------------------------------------------------
# Token dari @BotFather (bicara dengan dia, lalu /newbot)
TELEGRAM_BOT_TOKEN=

# --- Google Workspace -------------------------------------------------------
# Lokasi file JSON service account (default: credentials.json di root project)
GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json

# ID Google Sheet tempat pengajuan disimpan.
# Buka Sheet di browser -> bagian URL "/d/<ID_INI>/edit"
GOOGLE_SHEET_ID=

# ID folder Google Drive tujuan upload PDF.
# Buka folder di browser -> bagian URL "/folders/<ID_INI>"
GOOGLE_DRIVE_FOLDER_ID=

# --- Perusahaan -------------------------------------------------------------
# Nama perusahaan yang dicetak di header PDF
COMPANY_NAME=PT. Nama Perusahaan

# Path logo untuk header PDF (file PNG)
LOGO_PATH=png/logo.png

# --- Approver & HR ----------------------------------------------------------
# Untuk setiap approver: USER_ID (Telegram), NAME, TITLE, dan ESIGN (tanda tangan PNG).
# Cari Telegram User ID dengan mengirim pesan ke @userinfobot.
#
# Catatan tanda tangan: file tanda tangan asli TIDAK disertakan di repo ini.
# Folder "png/" hanya berisi placeholder (file tanda tangan + logo perusahaan
# milik orang lain tidak boleh ikut di-commit).
#
# Cara pakai tanda tangan Anda:
#   1. Buat folder "local_assets/" di root project (sudah masuk .gitignore)
#   2. Simpan file tanda tangan Anda di sana, misal local_assets/tanda_tangan_1.png
#   3. Ubah nilai APPROVER_1_ESIGN di bawah menunjuk ke file tersebut
#
# Nilai bawaan di bawah memakai placeholder dari folder "png/", jadi bot tetap
# bisa dijalankan tanpa menyiapkan file apa pun.

# Level 1 - Supervisor langsung
APPROVER_1_USER_ID=
APPROVER_1_NAME=Approver 1
APPROVER_1_TITLE=Direct Supervisor
APPROVER_1_ESIGN=png/esign_approver_1.png

# Level 2 - Section Head
APPROVER_2_USER_ID=
APPROVER_2_NAME=Approver 2
APPROVER_2_TITLE=Section Head
APPROVER_2_ESIGN=png/esign_approver_2.png

# Level 3 - Manager (khusus overtime)
APPROVER_3_USER_ID=
APPROVER_3_NAME=Approver 3
APPROVER_3_TITLE=Manager
APPROVER_3_ESIGN=png/esign_approver_3.png

# User ID Telegram HR (penerima notifikasi & dokumen)
HR_USER_ID=

# --- Validasi ---------------------------------------------------------------
# Maksimal hari ke depan untuk pengajuan (default 30)
MAX_FUTURE_DAYS=30

# Pengajuan lampiran masih diterima sampai N hari ke belakang (default 14)
MAX_PAST_DAYS=14

# Jeda minimal (detik) sebelum tombol yang sama diproses lagi (default 5)
BUTTON_DEBOUNCE_SECONDS=5

# --- Google Drive -----------------------------------------------------------
# Upload PDF ke Drive: true / false
# Catatan: service account tidak punya storage quota di My Drive, jadi upload
# ke folder biasa akan ditolak 403. Butuh Shared Drive + service account
# sebagai member (role: Content Manager).
DRIVE_UPLOAD_ENABLED=false

# Mode berbagi file:
#   link       -> siapa pun yang punya link bisa melihat & mengunduh (read only)
#   restricted -> hanya anggota folder tujuan yang bisa membuka
DRIVE_SHARE_MODE=link

# --- Distribusi dokumen -----------------------------------------------------
# Penerima tambahan berkas PDF (selain HR + pemohon).
# Kosongkan untuk mode standar: HR + pemohon.
# Pisahkan beberapa ID dengan spasi atau koma.
EXTRA_DOCUMENT_RECIPIENT_USER_IDS=

# --- Self-approval ----------------------------------------------------------
# Approver boleh menyetujui pengajuannya sendiri? (true / false)
ALLOW_APPROVER_SELF_APPROVAL=true

# Self-approval untuk semua orang (hanya untuk pengujian/emergency)
ALLOW_SELF_APPROVAL=false
